# WMS Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application
SECRET_KEY=wms-super-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./wms.db

# Gemini AI API (optional - deterministic fallback used if not set)
GEMINI_API_KEY=

# Weather API (optional - demo data used if not set)
OPENWEATHER_API_KEY=

# SMS Provider (optional - notifications shown in-app if not set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# App Mode
APP_ENV=development
